{
  "name": "jianguo-app",
  "version": "2.0.0",
  "description": "捡果 App 移动端跨平台工程 (Android & iOS 双端原生支持)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "axios": "^1.7.7",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-web": "~0.19.13",
    "lucide-react-native": "^0.454.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
